#include <stdio.h>

int main()
{
    int marks[10];
    int i, highest, lowest;
    int total = 0;
    float average;

    printf("Registration Number:HDB212-D1-0048/2026
    \n\n");
    for(i = 0; i < 10; i++)
    {
        printf("Enter mark for student %d: ", i + 1);
        scanf("%d", &marks[i]);
    }

    highest = marks[0];
    lowest = marks[0];
    for(i = 0; i < 10; i++)
    {
        total = total + marks[i];

        if(marks[i] > highest)
            highest = marks[i];

        if(marks[i] < lowest)
            lowest = marks[i];
    }

    average = total / 10.0;

    printf("\nAverage Mark = %.2f\n", average);
    printf("Highest Mark = %d\n", highest);
    printf("Lowest Mark = %d\n", lowest);

    printf("\nMarks greater than the average:\n");

    for(i = 0; i < 10; i++)
    {
        if(marks[i] > average)
        {
            printf("%d\n", marks[i]);
        }
    }

    return 0;
}
